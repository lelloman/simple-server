#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
target=${1:?usage: build-engine-artifact TARGET OUTPUT_DIRECTORY}
output=${2:?usage: build-engine-artifact TARGET OUTPUT_DIRECTORY}
case "$target" in
  x86_64-unknown-linux-gnu) platform=linux/amd64 ;;
  aarch64-unknown-linux-gnu) platform=linux/arm64 ;;
  *) echo "unsupported target: $target" >&2; exit 1 ;;
esac
docker buildx build --platform "$platform" --file crates/engine/Dockerfile \
  --target artifact --output "type=local,dest=$output" .
echo "Built local artifact for $target in $output; nothing was published."

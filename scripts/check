#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

cargo fmt --check
cargo clippy --locked --all-targets --all-features -- -D warnings
cargo test --locked
cargo test --locked --all-features
cargo test --locked --no-default-features --features database-migrations --test database_migrations
cargo test --locked --no-default-features --features database-sqlite-schema --test database_sqlite_schema --test database_sqlite_extended_creation --test database_sqlite
cargo run --locked --manifest-path tests/fixtures/sqlite_vec_creation/Cargo.toml
cargo test --locked --no-default-features --features lifecycle
cargo test --locked --no-default-features --features body-limit
cargo test --locked --no-default-features --features response-headers
cargo test --locked --no-default-features --features cors
cargo test --locked --no-default-features --features logging
cargo test --locked --no-default-features --features correlation
cargo test --locked --no-default-features --features http-tracing
cargo test --locked --no-default-features --features http-tracing,correlation
cargo test --locked --no-default-features --features sse --test web_sse
cargo test --locked --no-default-features --features test-harness --test test_harness
cargo test --locked --no-default-features --features test-harness-ws --test test_harness --test test_harness_ws
cargo test --locked --features lifecycle
cargo test --locked --no-default-features --features static-files --test static_files
cargo test --locked --no-default-features --features cookies --test web_cookies
cargo test --locked --no-default-features --features cookies,tower-cookies,test-harness --test web_cookies
cargo test --locked --no-default-features --features compression --test web_compression
cargo test --locked --no-default-features --features compression,test-harness --test web_compression
cargo test --locked --no-default-features --features unix-http,correlation --test web_unix
cargo test --locked --no-default-features --features unix-http,ws --test web_unix
cargo check --locked --no-default-features
RUSTDOCFLAGS="-D warnings" cargo doc --locked --no-deps --all-features
